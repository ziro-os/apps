{
  "schema": 1,
  "name": "valkey",
  "description": "Valkey (Redis-compatible, BSD) in-memory store with a password and append-only persistence",
  "default": "9",
  "versions": {
    "8": {
      "images": {
        "cache": "docker.io/valkey/valkey:8.1.10@sha256:640c5e62cea04b6d6f2084232651d0cc70362d31f4f805e7be94dbed6855e8f2"
      }
    },
    "9": {
      "images": {
        "cache": "docker.io/valkey/valkey:9.1.2@sha256:418652cfb58ef879d4978c33553735d7147016032d5aefaa14c828e611eb9dfd"
      }
    }
  },
  "secrets": {
    "VALKEY_PASSWORD": "alnum:32"
  },
  "components": [
    {
      "name": "cache",
      "port": 6379,
      "secrets": [
        "VALKEY_PASSWORD"
      ],
      "data": [
        "/data"
      ],
      "args": [
        "sh",
        "-c",
        "chown -R valkey:valkey /data && exec setpriv --reuid=valkey --regid=valkey --clear-groups -- valkey-server - --appendonly yes --dir /data --protected-mode no <<EOF\nrequirepass $VALKEY_PASSWORD\nEOF\n"
      ],
      "health": [
        "valkey-cli",
        "ping"
      ]
    }
  ],
  "outputs": {
    "url": "redis://:{{secret.VALKEY_PASSWORD}}@{{host}}:{{port}}",
    "password": "{{secret.VALKEY_PASSWORD}}",
    "host": "{{host}}",
    "port": "{{port}}"
  }
}
