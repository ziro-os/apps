{
  "schema": 1,
  "name": "postgres",
  "description": "PostgreSQL database with a generated password and persistent data",
  "default": "18",
  "versions": {
    "16": {
      "images": {
        "db": "docker.io/library/postgres:16.15@sha256:1a6ab3f5345eb6dbe04a1349529caabdb0ab09293a09590fad07b2246bfa4b54"
      }
    },
    "17": {
      "images": {
        "db": "docker.io/library/postgres:17.11@sha256:d74eeac9a635390a49bc21bd49fccd973de707e2a53a76ac49b552b8712ec46f"
      }
    },
    "18": {
      "images": {
        "db": "docker.io/library/postgres:18.6@sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722"
      }
    }
  },
  "settings": [
    {
      "name": "database",
      "description": "database created on first start",
      "default": "app",
      "pattern": "^[a-z_][a-z0-9_]{0,62}$"
    },
    {
      "name": "user",
      "description": "owner of that database",
      "default": "app",
      "pattern": "^[a-z_][a-z0-9_]{0,62}$"
    }
  ],
  "secrets": {
    "POSTGRES_PASSWORD": "alnum:32"
  },
  "components": [
    {
      "name": "db",
      "port": 5432,
      "env": {
        "POSTGRES_DB": "{{setting.database}}",
        "POSTGRES_USER": "{{setting.user}}",
        "PGDATA": "/var/lib/postgresql/data",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256 --data-checksums"
      },
      "secrets": [
        "POSTGRES_PASSWORD"
      ],
      "data": [
        "/var/lib/postgresql/data"
      ],
      "health": [
        "pg_isready",
        "-q",
        "-h",
        "127.0.0.1",
        "-U",
        "{{setting.user}}",
        "-d",
        "{{setting.database}}"
      ]
    }
  ],
  "outputs": {
    "url": "postgres://{{setting.user}}:{{secret.POSTGRES_PASSWORD}}@{{host}}:{{port}}/{{setting.database}}",
    "user": "{{setting.user}}",
    "password": "{{secret.POSTGRES_PASSWORD}}",
    "database": "{{setting.database}}",
    "host": "{{host}}",
    "port": "{{port}}"
  },
  "notes": "Versions are major lines: patch updates arrive with catalog updates (redeploy); moving 16 -> 17 needs a dump and restore into a new instance."
}
